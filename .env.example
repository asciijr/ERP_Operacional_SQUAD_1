# Copie para .env:  cp .env.example .env
# Valores FICTÍCIOS. Nunca coloque credenciais reais aqui (Guia de Engenharia 6.1 e 10.1).

# ---------- Banco (PostgreSQL) ----------
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp_operacional
DATABASE_URL=postgresql://erp:erp_dev_password@db:5432/erp_operacional?schema=public
# Porta do banco na SUA máquina (DBeaver, pgAdmin). Já tem PostgreSQL local? Use 5433.
DB_HOST_PORT=5432

# ---------- Backend (NestJS) ----------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:3000
